DATABASE_URL=postgres://tierra:tierra@localhost:5432/tierra
PORT=3002
EVOLUTION_URL=http://localhost:8081
EVOLUTION_API_KEY=tierra-evolution-key
EVOLUTION_WEBHOOK_SECRET=tierra-webhook-secret
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3002
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TYPESAFE_API_KEY=
# Seed demo accounts, customers and stock on an empty database. Never set in production.
SEED_DEMO=1
# Password for seeded accounts. Defaults to tierra-dev outside production.
SEED_PASSWORD=
# Set to 0 to stop running background jobs (the API still queues them).
WORKER_ENABLED=1
# personal: the bot shares someone's own phone. dedicated: the bot has its own number.
WHATSAPP_BOT_MODE=personal
# Country code added to a 10-digit mobile number typed without one.
DEFAULT_COUNTRY_CODE=91
