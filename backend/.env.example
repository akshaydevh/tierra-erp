DATABASE_URL=postgres://tierra:tierra@localhost:5432/tierra
PORT=3002
EVOLUTION_URL=http://localhost:8081
EVOLUTION_API_KEY=tierra-evolution-key
EVOLUTION_WEBHOOK_SECRET=tierra-webhook-secret
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3002
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only for reasoning models (gpt-5 family, o-series): none, minimal, low, medium, high, xhigh, max. Default low.
OPENAI_REASONING_EFFORT=
# The agent's tool loop; defaults to OPENAI_MODEL.
OPENAI_AGENT_MODEL=
# Agent turns without tools. Tool turns on GPT-5.4 and later always send none (Chat Completions requires it). Default low.
OPENAI_AGENT_REASONING_EFFORT=
# TypeSafe decides what an unclear admin reply to a pending sales order means (approve, send back, question). Empty: the OpenAI model does it.
TYPESAFE_API_KEY=
# Seed demo accounts, customers and stock on an empty database. Never set in production.
SEED_DEMO=1
# Password for seeded accounts. Defaults to tierra-dev outside production.
SEED_PASSWORD=
# Set to 0 to stop running background jobs (the API still queues them).
WORKER_ENABLED=1
# personal: the bot shares someone's own phone. dedicated: the bot has its own number.
WHATSAPP_BOT_MODE=personal
# Country code added to a 10-digit mobile number typed without one.
DEFAULT_COUNTRY_CODE=91
# Bank details printed on sales-order PDFs, lines separated by "|", e.g. "State Bank of India, <branch>|A/C <no> · IFSC <code>".
COMPANY_BANK=
# Where SAP attachment files live: fs:<dir> (default fs:./data/files, git-ignored) or s3 (any S3-compatible bucket,
# e.g. a Railway bucket). Fill with tools/sap-import `run.py attachments --store ...`. In production use s3: a deploy
# replaces the disk, so an fs store loses its files (the server warns at boot). With s3, S3_ENDPOINT, S3_BUCKET,
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are required (the server stops at boot naming any missing one);
# S3_REGION defaults to auto.
FILE_STORE=fs:./data/files
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
# path (MinIO, default) or virtual-host (a Railway bucket).
S3_URL_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
